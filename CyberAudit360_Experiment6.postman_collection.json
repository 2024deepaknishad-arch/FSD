{
  "info": {
    "_postman_id": "cyberaudit360-exp6-collection-id",
    "name": "CyberAudit 360 - Experiment 6 (JWT Authentication & Roles)",
    "description": "Postman Collection for Experiment 6: User registration, login, JWT issuance, protected profile, and User vs Admin RBAC authorization.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "userToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "TEST 1 - Register User",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Rahul Sharma\",\n  \"email\": \"rahul@cyberaudit.com\",\n  \"password\": \"Rahul@12345\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/users/register",
          "host": ["{{baseUrl}}"],
          "path": ["api", "users", "register"]
        },
        "description": "Registers a new standard user in MongoDB Atlas. Role defaults safely to 'user'. Password hashed with bcrypt."
      }
    },
    {
      "name": "TEST 2 - Login User",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.token) {",
              "    pm.collectionVariables.set('userToken', jsonData.token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"rahul@cyberaudit.com\",\n  \"password\": \"Rahul@12345\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/users/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "users", "login"]
        },
        "description": "Authenticates user credentials, compares bcrypt password hash, and returns signed JWT with user identity."
      }
    },
    {
      "name": "TEST 3 - User Profile (Valid User JWT)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{userToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users/profile",
          "host": ["{{baseUrl}}"],
          "path": ["api", "users", "profile"]
        },
        "description": "Accesses protected user profile using valid user JWT token. Expected: 200 OK (no password returned)."
      }
    },
    {
      "name": "TEST 4 - User Profile (No JWT)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/users/profile",
          "host": ["{{baseUrl}}"],
          "path": ["api", "users", "profile"]
        },
        "description": "Attempts access to protected route without an Authorization header. Expected: 401 Unauthorized."
      }
    },
    {
      "name": "TEST 5 - User Profile (Invalid JWT)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer invalid-token"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users/profile",
          "host": ["{{baseUrl}}"],
          "path": ["api", "users", "profile"]
        },
        "description": "Attempts access to protected route with an invalid/tampered token. Expected: 401 Unauthorized."
      }
    },
    {
      "name": "TEST 6 - Login Admin",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "var jsonData = pm.response.json();",
              "if (jsonData.token) {",
              "    pm.collectionVariables.set('adminToken', jsonData.token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"admin@cyberaudit.com\",\n  \"password\": \"Admin@12345\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/users/login",
          "host": ["{{baseUrl}}"],
          "path": ["api", "users", "login"]
        },
        "description": "Logs in with seeded administrator credentials to obtain an Admin JWT."
      }
    },
    {
      "name": "TEST 7 - Admin Route (Admin JWT)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{adminToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users/admin",
          "host": ["{{baseUrl}}"],
          "path": ["api", "users", "admin"]
        },
        "description": "Accesses privileged admin route with valid admin JWT. Expected: 200 OK."
      }
    },
    {
      "name": "TEST 8 - Admin Route (User JWT - Forbidden)",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{userToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/users/admin",
          "host": ["{{baseUrl}}"],
          "path": ["api", "users", "admin"]
        },
        "description": "Accesses privileged admin route using normal user JWT. Expected: 403 Forbidden (RBAC verification)."
      }
    }
  ]
}
