# =======================================================
# CYBERAUDIT 360 - ENVIRONMENT VARIABLES TEMPLATE (EXP 10)
# =======================================================

# Server configuration
PORT=5000
NODE_ENV=production

# MongoDB Atlas connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/cyberaudit360?retryWrites=true&w=majority

# JWT authentication secret
JWT_SECRET=your_production_jwt_secret_key_change_me

# Admin user registration secret
ADMIN_SECRET=your_admin_registration_secret_key

# Frontend production URL (Vercel deployment domain for CORS)
# Example: https://cyberaudit360.vercel.app
FRONTEND_URL=http://localhost:5173

# Frontend API base URL (REST endpoints - Render Web Service)
# Example: https://cyberaudit360-api.onrender.com
VITE_API_URL=http://localhost:5000
VITE_API_BASE_URL=http://localhost:5000

# Frontend Socket.IO server URL (for WebSocket connections)
VITE_SOCKET_URL=http://localhost:5000
