# Dockerfile for CyberAudit 360 React Frontend
# Experiment 7: Multi-stage build with Vite and Nginx

# Stage 1: Build the React/Vite application
FROM node:22-alpine AS build

WORKDIR /app

# Build arguments for Vite environment variables
ARG VITE_API_BASE_URL=http://localhost:5000
ARG VITE_SOCKET_URL=http://localhost:5000
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_SOCKET_URL=$VITE_SOCKET_URL

# Copy package manifests first for optimal caching
COPY package*.json ./

# Install dependencies using clean reproducible install
RUN npm ci

# Copy frontend source code
COPY . .

# Build the production assets
RUN npm run build

# Stage 2: Serve the built application with Nginx
FROM nginx:alpine

# Copy custom Nginx configuration (supporting SPA routing & /api proxying)
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Copy production build artifacts from the build stage
COPY --from=build /app/dist /usr/share/nginx/html

# Expose web server port
EXPOSE 80

# Run Nginx in foreground
CMD ["nginx", "-g", "daemon off;"]
